# SMTP server settings (for email notifications).
#
# These are fallbacks: you can also configure SMTP from the web console
# (it is stored in config.json and takes precedence). Secrets stored in
# this file are not exposed by the console.
#
# For Gmail, use an App Password (not your normal password):
# https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Sender and recipient (only used if not set in config.json)
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# Telegram notifications (optional). These are fallbacks; you can also
# configure them from the web console (Settings page), which takes precedence.
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web console port (default: 7823)
PORT=7823
